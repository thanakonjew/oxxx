# Copy to .env.local and fill in. Any Postgres works (Neon, Supabase, Vercel Postgres, local).
# With a pooled connection string (e.g. Neon's -pooler host or Supabase port 6543), keep the pooler URL here;
# the app disables prepared statements so transaction-mode pooling works.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/oxxx
